# Reference only — ASP.NET Core does NOT load .env files automatically.
# Export these as environment variables (double underscores map to `:`), or use
# dotnet user-secrets / appsettings.Local.json. Never commit real values.

Jwt__Secret=replace-with-a-random-secret-at-least-32-characters-long
Jwt__Issuer=SANAD
Jwt__Audience=SANAD.Client
Jwt__ExpiryMinutes=15
RefreshToken__LifetimeDays=7

ConnectionStrings__Default=Server=localhost;Database=SANAD;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

Cors__AllowedOrigins__0=http://localhost:5173

# Required in all environments. Supply real values using .NET User Secrets in
# development or environment variables/a secure secret manager in deployment.
Seed__SuperAdminEmail=
Seed__SuperAdminPassword=

# Optional and Development only. Leave both empty to skip creating a Manager.
# Production environments must never define these variables.
Seed__ManagerEmail=
Seed__ManagerPassword=
